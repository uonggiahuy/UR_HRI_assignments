<?xml version="1.0" encoding="UTF-8"?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <!-- Local simulation must not depend on Wi-Fi or VPN multicast routing.
           Linux loopback supports multicast sockets despite its interface flag. -->
      <Interfaces>
        <NetworkInterface name="lo" multicast="true" />
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
    </General>
  </Domain>
</CycloneDDS>
